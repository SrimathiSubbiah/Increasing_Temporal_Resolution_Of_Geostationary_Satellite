data/raw_data/
data/triplets/

# large per-sample prediction dumps (npz arrays used to build the figures) --
# regenerate via eval/evaluate_*.py. outputs/figures/ and outputs/*.json are
# kept -- those ARE the results.
outputs/*_predictions/
outputs/*_midframes/

.env
