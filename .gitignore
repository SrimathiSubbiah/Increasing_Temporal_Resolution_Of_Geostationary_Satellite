__pycache__/
*.pyc

.venv/
venv/

.claude/

# model checkpoints -- ~10MB each, regenerate via train*.py (uncomment to track them instead, they're small enough)
checkpoint.pt
checkpoint_attention_unet.pt
checkpoint_resunet.pt

# raw + processed satellite data -- tens of GB, regenerate via:
